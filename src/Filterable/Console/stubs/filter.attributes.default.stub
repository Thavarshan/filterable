<?php

namespace {{ namespace }};

use Filterable\Attributes\AsFilter;
use Filterable\Attributes\FilterRules;
use Filterable\Filter;

class {{ class }} extends Filter
{
    #[AsFilter('name'), FilterRules(['string', 'max:255'])]
    protected function name(string $value): void
    {
        $this->getBuilder()->where('name', $value);
    }
}
